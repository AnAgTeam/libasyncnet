@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Boost CONFIG COMPONENTS json)

# The exported targets file is asyncnet-targets.cmake (install(EXPORT
# asyncnet-targets)); the old include referenced a non-existent
# AsyncNetwork-targets.cmake, so find_package(asyncnet) errored on a missing file.
include("${CMAKE_CURRENT_LIST_DIR}/asyncnet-targets.cmake")

# NOTE: the vendored curlpp and libcoro static libs (and curl) are not installed
# or exported, so they are not required here. A consumer linking asyncnet::asyncnet
# must still provide those itself until they are installed/exported.
